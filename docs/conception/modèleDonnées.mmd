erDiagram
    DOCUMENT ||--o{ DOCUMENT_AGENT : "has agent"
    DOCUMENT ||--o{ DOCUMENT_SUBJECT : "has subject (a pour sujet)"
    DOCUMENT ||--o{ DOCUMENT_DESCRIPTION : "has description (a pour description)"
    DOCUMENT ||--o{ DOCUMENT_CATEGORY : "is classified in (est classé dans)"
    CATEGORY "categorie" ||--o{ CATEGORY : "has sub-category (a pour sous-catégorie)"
    CATEGORY ||--o{ DOCUMENT_CATEGORY : "used for classification (sert au classement)"
    DOCUMENT }o--|| ISSUER "emetteur" : "is issued by (est émis par)"
    ISSUER ||--o{ DOCUMENT : "issues (émet)"
    DOCUMENT ||--o{ CONVERSION : "has text version (a pour version texte)"

    DOCUMENT "document" {
        integer doc_id PK
        text dc_title
        text dc_date
        text dc_type
        text dc_format
        text dc_identifier
        text dc_language
        text dc_rights
        integer issuer_id FK "emetteur_id"
        text source_file "fichier_source"
        text date_added "date_ajout"
        text status "statut"
        text reference
        text attributes "attributs"
    }
    DOCUMENT_AGENT "document_agent" {
        integer doc_id FK
        text role
        text value "valeur"
    }
    DOCUMENT_SUBJECT "document_sujet" {
        integer doc_id FK
        text value "valeur"
    }
    DOCUMENT_DESCRIPTION "document_description" {
        integer doc_id FK
        text value "valeur"
    }
    CATEGORY "categorie" {
        integer category_id PK "categorie_id"
        integer parent_id FK
        text label "libellé"
        integer depth "profondeur"
        integer active "actif"
    }
    DOCUMENT_CATEGORY "document_categorie" {
        integer doc_id FK
        integer category_id FK "categorie_id"
        integer is_primary "principal"
        text classification_date "date_classement"
    }
    ISSUER "emetteur" {
        integer issuer_id PK "emetteur_id"
        text label "libellé"
        text linked_category "categorie_liee"
    }
    CONVERSION "conversion" {
        integer doc_id FK
        text extracted_text "texte_extrait"
        text model "modele"
        text conversion_date "date_conversion"
    }
